# The results of a run. They are large, they are machine-local, and a new run
# makes them again. The scripts write no log file, but `| tee run.log` does.
preds*.jsonl
*.log
*.score.*.json
*.transcripts/
logs/

# The byte code that Python writes when a script imports a module of this
# directory. The tests and `swebench_run.py` both make it.
__pycache__/
